# Names only. Real values live in Coolify env vars (never in git).
HUB_MODE=live                 # demo | live
PUBLIC_URL=https://map.imdev.ir
POSTGRES_PASSWORD=
# Single admin: `vpnmap admin hash-password` and `vpnmap admin totp`
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=               # 32+ random bytes, e.g. openssl rand -base64 48
# sha256 of your personal CLI token(s), comma separated
CLI_TOKEN_SHA256=
# One entry per server: node=sha256(token); `vpnmap agent token <node>` prints it
AGENT_TOKENS=
# Dedicated Remnawave monitoring user's API token (read-only use)
RW_API_URL=https://pl.api.mohiraweb.ir
RW_API_TOKEN=
# 3x-ui on the France exit (read-only use of the inbound list)
XUI_FRANCE_URL=
XUI_FRANCE_USER=
XUI_FRANCE_PASS=
# Telegram via the existing Cloudflare Workers proxy (phase 2 alerts)
TELEGRAM_API_ROOT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Build mirrors (Iran), as in XBridger
NPM_REGISTRY=
ALPINE_MIRROR=
GOPROXY=

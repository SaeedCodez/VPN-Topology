# Names only. Real values live in Coolify env vars (never in git).
HUB_MODE=live                 # demo | live
PUBLIC_URL=https://map.imdev.ir
POSTGRES_PASSWORD=
# Single admin: `vpnmap admin hash-password` and `vpnmap admin totp`
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=               # 32+ random bytes, e.g. openssl rand -base64 48
# sha256 of your personal CLI token(s), comma separated
CLI_TOKEN_SHA256=
# One entry per server: node=sha256(token); `vpnmap agent token <node>` prints it
AGENT_TOKENS=
# Dedicated Remnawave monitoring user's API token (read-only use)
RW_API_URL=https://pl.api.mohiraweb.ir
RW_API_TOKEN=
# 3x-ui on the France exit (read-only use of the inbound list)
XUI_FRANCE_URL=
XUI_FRANCE_USER=
XUI_FRANCE_PASS=
# End-to-end probe (container `probe`): its push token (sha256 goes in AGENT_TOKENS as probe=<sha>)
PROBE_TOKEN=
# One sing-box outbound (JSON, one line) of the Remnawave monitoring user per route
PROBE_OUTBOUND_MAIN=
PROBE_OUTBOUND_MULLVAD_DE=
PROBE_OUTBOUND_MULLVAD_US=
PROBE_OUTBOUND_MULLVAD_TR=
# shortUuid of the same user: the subscription route fetches its real subscription
PROBE_SUBSCRIPTION_ID=
# Telegram via the existing Cloudflare Workers proxy (phase 2 alerts)
TELEGRAM_API_ROOT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notion internal integration (capability "Read content" only), connected to the
# VPN Infrastructure page: the Telegram assistant reads the docs. Empty = off.
NOTION_TOKEN=
# Root page id or URL; empty = the docs: link in topology/map.yaml
NOTION_ROOT_PAGE=
# Build mirrors (Iran), as in XBridger
NPM_REGISTRY=
ALPINE_MIRROR=
GOPROXY=

{
  "$comment": "Generated by `vpnmap ops types --write` from pkg/ops/types.go. Do not edit.",
  "max_line": 1024,
  "max_token": 64,
  "types": [
    {
      "name": "ping",
      "kind": "read",
      "where": "server",
      "title": "Runner check",
      "doc": "Answers with the node id and the hash of the installed runner config.",
      "params": null,
      "disruptive": false
    },
    {
      "name": "container.list",
      "kind": "read",
      "where": "server",
      "title": "Containers",
      "doc": "docker ps (name and status) of the declared containers.",
      "params": null,
      "disruptive": false
    },
    {
      "name": "container.stats",
      "kind": "read",
      "where": "server",
      "title": "Container CPU/memory",
      "doc": "docker stats --no-stream for one container.",
      "params": [
        {
          "name": "container",
          "source": "containers"
        }
      ],
      "disruptive": false
    },
    {
      "name": "container.logs",
      "kind": "read",
      "where": "server",
      "title": "Container logs",
      "doc": "docker logs --since/--tail for one container.",
      "params": [
        {
          "name": "container",
          "source": "containers"
        },
        {
          "name": "since",
          "source": "fixed",
          "enum": [
            "5m",
            "15m",
            "1h"
          ]
        },
        {
          "name": "tail",
          "source": "fixed",
          "enum": [
            "50",
            "100",
            "200"
          ]
        }
      ],
      "disruptive": false
    },
    {
      "name": "container.restart",
      "kind": "change",
      "where": "server",
      "title": "Restart container",
      "doc": "docker restart of a container declared with restart: true.",
      "params": [
        {
          "name": "container",
          "source": "restartable-containers"
        }
      ],
      "disruptive": true,
      "cooldown": "10m"
    },
    {
      "name": "unit.status",
      "kind": "read",
      "where": "server",
      "title": "Unit status",
      "doc": "systemctl show: active state, since, restarts.",
      "params": [
        {
          "name": "unit",
          "source": "units"
        }
      ],
      "disruptive": false
    },
    {
      "name": "unit.restart",
      "kind": "change",
      "where": "server",
      "title": "Restart unit",
      "doc": "systemctl restart of a unit declared with restart: true.",
      "params": [
        {
          "name": "unit",
          "source": "restartable-units"
        }
      ],
      "disruptive": true,
      "cooldown": "10m"
    },
    {
      "name": "log.tail",
      "kind": "read",
      "where": "server",
      "title": "Log tail",
      "doc": "Last lines of a declared log file (by id; the path stays on the server).",
      "params": [
        {
          "name": "log",
          "source": "logs"
        },
        {
          "name": "lines",
          "source": "fixed",
          "enum": [
            "20",
            "50",
            "100"
          ]
        }
      ],
      "disruptive": false
    },
    {
      "name": "disk.usage",
      "kind": "read",
      "where": "server",
      "title": "Disk usage",
      "doc": "df of /.",
      "params": null,
      "disruptive": false
    },
    {
      "name": "tcp.check",
      "kind": "read",
      "where": "server",
      "title": "TCP connect",
      "doc": "TCP connect from this server, 5 s timeout.",
      "params": [
        {
          "name": "target",
          "source": "tcp-targets"
        }
      ],
      "disruptive": false
    },
    {
      "name": "conns.count",
      "kind": "read",
      "where": "server",
      "title": "Connections",
      "doc": "Established TCP connections with this local or remote port.",
      "params": [
        {
          "name": "port",
          "source": "ports"
        }
      ],
      "disruptive": false
    },
    {
      "name": "wg.handshakes",
      "kind": "read",
      "where": "server",
      "title": "WireGuard handshakes",
      "doc": "Latest handshake age and bytes per peer (never keys).",
      "params": [
        {
          "name": "iface",
          "source": "wg"
        }
      ],
      "disruptive": false
    },
    {
      "name": "script.read",
      "kind": "read",
      "where": "server",
      "title": "Read script",
      "doc": "A declared read script in /etc/vpnmap-ops/actions.d (plus its own params).",
      "params": [
        {
          "name": "script",
          "source": "read-scripts"
        }
      ],
      "disruptive": false
    },
    {
      "name": "script.change",
      "kind": "change",
      "where": "server",
      "title": "Change script",
      "doc": "A declared change script in /etc/vpnmap-ops/actions.d (plus its own params).",
      "params": [
        {
          "name": "script",
          "source": "change-scripts"
        }
      ],
      "disruptive": true,
      "cooldown": "10m"
    },
    {
      "name": "rw.nodes",
      "kind": "read",
      "where": "remnawave",
      "title": "Remnawave nodes",
      "doc": "GET /api/nodes: name, connected, disabled, Xray uptime, users online.",
      "params": null,
      "disruptive": false
    },
    {
      "name": "rw.system",
      "kind": "read",
      "where": "remnawave",
      "title": "Remnawave system",
      "doc": "GET /api/system/stats: counts only.",
      "params": null,
      "disruptive": false
    },
    {
      "name": "rw.node-restart",
      "kind": "change",
      "where": "remnawave",
      "title": "Restart Remnawave node",
      "doc": "POST /api/nodes/{uuid}/actions/restart (uuid looked up by name).",
      "params": [
        {
          "name": "node",
          "source": "remnawave"
        }
      ],
      "disruptive": true,
      "cooldown": "10m"
    },
    {
      "name": "rw.node-disable",
      "kind": "change",
      "where": "remnawave",
      "title": "Disable Remnawave node",
      "doc": "POST /api/nodes/{uuid}/actions/disable.",
      "params": [
        {
          "name": "node",
          "source": "remnawave"
        }
      ],
      "disruptive": true,
      "cooldown": "10m",
      "rollback": "rw.node-enable"
    },
    {
      "name": "rw.node-enable",
      "kind": "change",
      "where": "remnawave",
      "title": "Enable Remnawave node",
      "doc": "POST /api/nodes/{uuid}/actions/enable.",
      "params": [
        {
          "name": "node",
          "source": "remnawave"
        }
      ],
      "disruptive": false,
      "cooldown": "10m",
      "rollback": "rw.node-disable"
    }
  ]
}

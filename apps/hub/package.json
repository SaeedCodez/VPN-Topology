{
  "name": "@vpnmap/hub",
  "version": "0.1.0",
  "private": true,
  "description": "VPN Topology hub: loads the topology, ingests agent pushes, evaluates health and root cause, serves the API and WebSocket.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "tsc -p tsconfig.json && node --test --enable-source-maps dist/**/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.15",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@resvg/resvg-js": "2.6.2",
    "drizzle-orm": "0.44.7",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ssh2": "1.16.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}

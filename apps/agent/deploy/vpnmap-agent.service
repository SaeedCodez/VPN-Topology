# VPN Topology monitoring agent: read-only, unprivileged, pushes to the hub.
# Installed by install.sh as /etc/systemd/system/vpnmap-agent.service.
#
# The agent runs as the system user vpnmap-agent with no capabilities. Reads
# that need root (nft counters, wg peers, docker state, local checks) go
# through vpnmap-agent-helper.socket, whose fixed operations are validated
# against the root-owned /etc/vpnmap-agent/agent.yaml.
[Unit]
Description=VPN Topology monitoring agent (read-only)
After=network-online.target vpnmap-agent-helper.socket
Wants=network-online.target vpnmap-agent-helper.socket

[Service]
Type=simple
User=vpnmap-agent
Group=vpnmap-agent
# Installs the counter-only table `inet vpnmap` (and nothing else) as root.
# "+" = full privileges for this line only; "-" = a failure (e.g. nft not
# installed) does not stop the agent: the board then shows an nft error
# instead of losing every other collector.
ExecStartPre=-+/usr/local/bin/vpnmap-agent nft-apply --config /etc/vpnmap-agent/agent.yaml
ExecStart=/usr/local/bin/vpnmap-agent run --config /etc/vpnmap-agent/agent.yaml
Restart=always
RestartSec=5
TimeoutStopSec=15
Environment=GOMEMLIMIT=48MiB

# --- privileges: none -------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# --- filesystem: read-only view, secrets hidden ------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
StateDirectory=vpnmap-agent
StateDirectoryMode=0700
UMask=0077
# Never readable by the agent, whatever agent.yaml says ("-": may not exist).
InaccessiblePaths=-/opt/remnawave/.env -/opt/remnanode/.env -/etc/wireguard -/etc/mullvad-ns -/etc/x-ui -/usr/local/x-ui -/root -/etc/ssh -/etc/letsencrypt

# --- kernel and process hardening -------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# --- resources: a monitoring agent must never hurt the server ----------------
MemoryMax=64M
CPUQuota=10%
TasksMax=64
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
